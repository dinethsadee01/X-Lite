graph TB
    subgraph Client["👤 Client"]
        User[User/Browser]
    end
    
    subgraph Frontend["⚛️ Frontend (React)"]
        UI[UI Components<br/>Upload | Results | Report]
    end
    
    subgraph Backend["🔧 Backend (FastAPI)"]
        API[REST API<br/>/upload | /predict | /report]
        Services[Services<br/>Image | Prediction | Report]
    end
    
    subgraph ML["🤖 ML Layer"]
        Model[Student Model<br/>CNN-Transformer<br/>14 Diseases]
        GradCAM[Grad-CAM<br/>Explainability]
    end
    
    subgraph Data["💾 Data"]
        Storage[(Storage<br/>Images | Models | Reports)]
    end
    
    User -->|HTTP| UI
    UI -->|REST API| API
    API --> Services
    Services --> Model
    Services --> GradCAM
    Services --> Storage
    Model --> Storage
    
