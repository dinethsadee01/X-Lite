    Dataset --> Images[112K X-Ray Images]
    Dataset --> Labels[Multi-Label Annotations]
    Dataset --> Splits[Data Splits]
    
    Splits --> TrainSet[Train 70%]
    Splits --> ValSet[Validation 15%]
    Splits --> TestSet[Test 15%]
    
    Labels --> Diseases[14 Diseases]
    
