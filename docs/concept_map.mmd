graph TB
    %% Main System
    XLite[X-Lite System]
    XLite --> WebApp[Web Application]
    XLite --> MLPipeline[ML Pipeline]
    XLite --> Dataset[ChestX-ray14 Dataset]
    
    %% Web Application
    WebApp --> Frontend[React Frontend]
    WebApp --> Backend[FastAPI Backend]
    WebApp --> Services[Service Layer]
    
    Frontend --> Upload[Image Upload]
    Frontend --> Results[Results Display]
    Frontend --> Report[PDF Report]
    
    Backend --> API[REST API]
    API --> UploadEP[/api/upload]
    API --> PredictEP[/api/predict]
    API --> ReportEP[/api/report]
    API --> HealthEP[/api/health]
    
    Services --> ImageSvc[Image Service]
    Services --> PredSvc[Prediction Service]
    Services --> ReportSvc[Report Service]
    
    %% ML Pipeline
    MLPipeline --> Training[Training Pipeline]
    MLPipeline --> Inference[Inference Pipeline]
    MLPipeline --> Models[Model Architecture]
    
    Training --> KD[Knowledge Distillation]
    KD --> Teacher[Teacher Model]
    KD --> Student[Student Model]
    
    Teacher --> DenseNet[DenseNet121]
    DenseNet --> CheXNet[CheXNet Weights]
    
    Student --> Backbone[CNN Backbone]
    Student --> Attention[Attention Module]
    Student --> ClassHead[Classification Head]
    
    Backbone --> EfficientNet[EfficientNet-B0]
    Backbone --> ConvNeXt[ConvNeXt-Tiny]
    Backbone --> MobileNet[MobileNetV3]
    
    Attention --> MHSA[Multi-Head Self-Attention]
    Attention --> Performer[Performer]
    Attention --> LinearAttn[Linear Attention]
    
    ClassHead --> Output[14 Disease Classes]
    
    Training --> Loss[Loss Functions]
    Loss --> KDLoss[KD Loss]
    Loss --> BCELoss[BCE Loss]
    Loss --> PosWeight[Positive Weights]
    
    Training --> Optimizer[AdamW Optimizer]
    Training --> Scheduler[ReduceLROnPlateau]
    Training --> EarlyStopping[Early Stopping]
    
    %% Inference Pipeline
    Inference --> Preprocessing[Preprocessing]
    Inference --> Prediction[Prediction]
    Inference --> PostProcessing[Post-Processing]
    Inference --> Explainability[Explainability]
    
    Preprocessing --> CLAHE[CLAHE Enhancement]
    Preprocessing --> Resize[Resize 224x224]
    Preprocessing --> Normalize[Normalization]
    
    Prediction --> Forward[Forward Pass]
    Prediction --> Sigmoid[Sigmoid Activation]
    
    PostProcessing --> Threshold[Confidence Threshold]
    PostProcessing --> RiskLevel[Risk Level Assignment]
    
    RiskLevel --> HighRisk[High Risk >70%]
    RiskLevel --> MediumRisk[Medium Risk 50-70%]
    RiskLevel --> LowRisk[Low Risk <50%]
    
    Explainability --> GradCAM[Grad-CAM]
    GradCAM --> Heatmap[Activation Heatmap]
    GradCAM --> Visualization[Visual Overlay]
    
