%%  X-Lite Class Diagram
%%  Backend services, ML models, and data pipeline classes

classDiagram
    class FastAPIApp {
        +title: str
        +version: str
        +startup_event()
        +shutdown_event()
        +root()
    }

    class AuthRouter {
        +login(username, password) TokenResponse
        +verify_token(token) UserInfo
    }

    class UploadRouter {
        +upload_image(file) UploadResponse
    }

    class PredictRouter {
        +predict(image_path) PredictionResponse
    }

    class ReportRouter {
        +generate_report(prediction_data) PDFResponse
    }

    class HealthRouter {
        +health_check() HealthResponse
    }

    class ImageService {
        -ALLOWED_EXTENSIONS: set
        -MAX_FILE_SIZE: int
        +validate_image(file) bool
        +save_image(file, path) str
        +get_image_info(path) dict
    }

    class PredictionService {
        -model: HybridStudentModel
        -device: torch.device
        -thresholds: dict
        -disease_labels: list
        +__init__()
        +load_model() void
        +load_thresholds() void
        +apply_clahe(image) ndarray
        +preprocess(image_path) Tensor
        +predict(image_path) dict
        +get_risk_level(probability) str
    }

    class GradCAMService {
        -model: HybridStudentModel
        -target_layer: Module
        +__init__(model)
        +generate_heatmap(image, class_idx) ndarray
        +overlay_heatmap(original, heatmap, alpha) ndarray
        +save_heatmap(heatmap, path) str
    }

    class ReportService {
        -DISCLAIMER: str
        +generate_pdf(prediction, images) bytes
        -_add_header(canvas) void
        -_add_images(canvas, xray, heatmap) void
        -_add_findings(canvas, predictions) void
        -_add_disclaimer(canvas) void
    }

    class HybridStudentModel {
        -backbone: EfficientNetB0
        -attention: PerformerAttention
        -head: Linear
        -num_classes: int
        +__init__(architecture, num_classes, pretrained)
        +forward(x) Tensor
    }

    class EfficientNetB0Backbone {
        -features: Sequential
        -output_dim: int
        +__init__(pretrained)
        +forward(x) Tensor
    }

    class PerformerAttention {
        -dim: int
        -heads: int
        -nb_features: int
        -qkv: Linear
        -out: Linear
        +__init__(dim, heads, nb_features)
        +forward(x) Tensor
        -_favor_plus(q, k) Tensor
    }

    class CLAHEPreprocessor {
        -clip_limit: float
        -tile_grid_size: tuple
        +__init__(clip_limit, tile_grid_size)
        +apply(image) ndarray
    }

    class ChestXray14Dataset {
        -df: DataFrame
        -image_dir: str
        -labels: list
        -transform: Compose
        +__init__(df, image_dir, labels, transform)
        +__len__() int
        +__getitem__(idx) tuple
    }

    class PerClassAlphaFocalLoss {
        -alphas: Tensor
        -gamma: float
        +__init__(class_counts, gamma)
        +forward(logits, targets) Tensor
    }

    class Config {
        +MODEL_PATH: str
        +UPLOAD_FOLDER: str
        +API_HOST: str
        +API_PORT: int
        +DISEASE_LABELS: list
        +create_directories()
    }

    FastAPIApp --> AuthRouter
    FastAPIApp --> UploadRouter
    FastAPIApp --> PredictRouter
    FastAPIApp --> ReportRouter
    FastAPIApp --> HealthRouter
    FastAPIApp --> Config

    UploadRouter --> ImageService
    PredictRouter --> PredictionService
    PredictRouter --> GradCAMService
    ReportRouter --> ReportService

    PredictionService --> HybridStudentModel
    PredictionService --> CLAHEPreprocessor
    GradCAMService --> HybridStudentModel

    HybridStudentModel --> EfficientNetB0Backbone
    HybridStudentModel --> PerformerAttention

    ChestXray14Dataset --> CLAHEPreprocessor
    PerClassAlphaFocalLoss --> HybridStudentModel
