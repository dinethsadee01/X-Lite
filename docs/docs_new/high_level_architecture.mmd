%%  X-Lite High-Level Architecture Diagram (Three-Tier)
%%  Presentation Tier → Logic Tier → Data Tier

graph TB
    %% ════════════════════════════════════════════════════
    %% PRESENTATION TIER
    %% ════════════════════════════════════════════════════
    subgraph PresentationTier["Presentation Tier"]
        direction TB
        LP["Login Page"] --> HP
        HP["Home Page"] --> INST["Instructions Page"]

        subgraph DiagnosisPage["Diagnosis Page"]
            direction LR
            XUI["X-Ray Upload<br/>Interface"] --> XPI["X-Ray Preview<br/>Interface"] --> DPD["Disease Prediction<br/>Display Interface"]
        end

        HP --> XUI
        DPD --> RDP["Predicted Result &<br/>Grad-CAM Explanation<br/>Report Display Page"]
    end

    %% ════════════════════════════════════════════════════
    %% LOGIC TIER
    %% ════════════════════════════════════════════════════
    subgraph LogicTier["Logic Tier"]
        direction TB
        PS["FastAPI Server<br/>REST API + CORS + JWT"]

        ILM["Input X-Ray<br/>Loader Module"]
        IPM["Input X-Ray<br/>Preprocessor<br/>CLAHE + Resize + Normalize"]

        subgraph DetectionModule["X-Ray Classification Module"]
            direction TB
            DMLM["Classification Model<br/>Loader Module"]
            PGM["Prediction Generator<br/>Module"]
        end

        subgraph MLPipeline["ML Training Pipeline"]
            direction TB
            DPM["Data Preprocessor<br/>Module"]
            MTM["Model Train<br/>Module"]
            MEM["Model Evaluate<br/>Module"]
        end

        XAIM["Grad-CAM Explainability<br/>Integrator Module"]
        EOLM["Explanation Output &<br/>PDF Report Loader Module"]

        PS --> ILM
        ILM --> IPM
        IPM --> DMLM
        DMLM --> PGM
        PGM -.-> XAIM
        XAIM -.-> EOLM
        PGM --> EOLM

        DPM --> MTM --> MEM
        MEM -.-> XAIM
    end

    %% ════════════════════════════════════════════════════
    %% DATA TIER
    %% ════════════════════════════════════════════════════
    subgraph DataTier["Data Tier"]
        direction LR
        UIRD[("User Input X-Rays<br/>& Prediction Results<br/>uploads/")]
        MDS[("ChestX-ray14<br/>Dataset Storage<br/>112,120 Images")]
        MCP[("Model Checkpoints<br/>& Thresholds<br/>best_checkpoint.pth")]
    end

    %% ════════════════════════════════════════════════════
    %% CROSS-TIER CONNECTIONS
    %% ════════════════════════════════════════════════════
    XUI -->|"HTTP POST /api/upload"| PS
    DPD -->|"HTTP POST /api/predict"| PS
    RDP -->|"HTTP POST /api/report"| PS
    LP -->|"HTTP POST /api/auth/login"| PS

    EOLM --> UIRD
    ILM --> UIRD
    DMLM --> MCP
    DPM --> MDS
    MTM --> MCP

    %% ════════════════════════════════════════════════════
    %% STYLING
    %% ════════════════════════════════════════════════════
    style PresentationTier fill:#dbeafe,stroke:#3b82f6,stroke-width:2px,color:#1e3a5f
    style LogicTier fill:#fef3c7,stroke:#f59e0b,stroke-width:2px,color:#78350f
    style DataTier fill:#d1fae5,stroke:#10b981,stroke-width:2px,color:#064e3b
    style DetectionModule fill:#f3f4f6,stroke:#6b7280,stroke-width:2px,stroke-dasharray:5 5
    style MLPipeline fill:#f3f4f6,stroke:#6b7280,stroke-width:2px,stroke-dasharray:5 5
    style DiagnosisPage fill:#eff6ff,stroke:#93c5fd,stroke-width:1px
